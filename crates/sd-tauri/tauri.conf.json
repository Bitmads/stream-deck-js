{
  "$schema": "https://raw.githubusercontent.com/nicothin/tauri-docs/main/src/.vuepress/public/schema/tauri-2.0.schema.json",
  "productName": "Open Stream Deck",
  "identifier": "com.open-stream-deck.app",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../../packages/ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter ui dev",
    "beforeBuildCommand": "pnpm --filter ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Open Stream Deck",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http: https: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss: http: https:",
        "media-src": "'self' data: blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../plugins/stock-quotes.sdPlugin/manifest.json": "plugins/stock-quotes.sdPlugin/manifest.json",
      "../../plugins/stock-quotes.sdPlugin/plugin.js": "plugins/stock-quotes.sdPlugin/plugin.js",
      "../../plugins/stock-quotes.sdPlugin/config.schema.json": "plugins/stock-quotes.sdPlugin/config.schema.json"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
