{
  "manifest_version": 3,
  "name": "Open Stream Deck - Chrome Tabs",
  "version": "1.1.0",
  "description": "Sync pinned Chrome tabs to your Stream Deck via Open Stream Deck API",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8484/*",
    "http://localhost:8484/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Stream Deck Tabs"
  }
}
